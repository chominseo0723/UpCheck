rflow-wrap:anywhere;font-size:12px;color:#51475e}.empty{text-align:center;padding:65px 12px;color:var(--muted);font-size:12px;border:1px dashed #dfdae7;border-radius:9px;margin:18px 0}.empty:before{content:'아직 접수된 메일이 없어요';display:block;font-size:15px;color:#655b73;font-weight:600;margin-bottom:10px}#message{margin:15px 0 0;white-space:pre-wrap;font-size:12px}.error{color:#b53a42;padding:12px;background:#fff0f1;border-radius:8px}.ok{color:#69568a}summary{cursor:pointer;font-size:12px;color:var(--green);margin-top:13px}details[open]{margin-bottom:14px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.8 'Malgun Gothic',sans-serif;background:#faf9fc;padding:12px;border-radius:6px}.hint{font-size:11px;margin:8px 0 13px}a{color:var(--green)}:focus-visible{outline:3px solid #b5a3ff;outline-offset:3px}.flow{margin-top:25px;padding:20px 24px;background:#fff;border:1px solid var(--line);border-radius:12px;scroll-margin-top:25px}.flowhead{display:flex;justify-content:space-between;margin-bottom:15px;font-size:12px;font-weight:600}.flowhead span{color:var(--muted);font-size:11px;font-weight:400}.nodes{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.node{display:flex;align-items:center;gap:9px;background:#fcfbfe;border:1px solid var(--line);border-radius:7px;padding:10px 13px;min-width:120px;font-size:12px}.node b{font-weight:600}.node small{display:block;color:var(--muted);font-size:10px}.node i{width:26px;height:26px;border-radius:6px;display:grid;place-items:center;background:#ede6ff;color:var(--green);font-style:normal;font-weight:700}.arrow{color:#c0b7ce}.footnote{margin:20px 0;font-size:11px;color:var(--muted)}.result-json{border-top:1px solid var(--line);margin-top:12px;padding-top:2px}\n@media(min-width:1500px){main{padding-left:50px;padding-right:50px}}@media(max-width:1180px){header{width:188px;padding:25px 14px}.brand svg{width:145px}main{margin-left:188px;padding:25px}.grid{grid-template-columns:1fr}.grid #inbox{grid-row:1}}@media(max-width:700px){header{position:static;width:auto;padding:15px 18px;border-right:0;border-bottom:1px solid var(--line);display:block}.brand{padding:0}.brand svg{width:136px}.workspace,.navlabel,.sidebarfoot{display:none}nav{display:flex;gap:5px;margin-top:13px}nav a{padding:7px 9px;margin:0;font-size:11px}main{margin-left:0;padding:20px 16px}.crumb{padding-bottom:16px}h1{font-size:25px}.panel{padding:20px}.top{align-items:flex-start;flex-wrap:wrap}.counts{gap:7px}.counts>div{padding:10px}.itemtop{flex-wrap:wrap}.nodes{gap:8px}.node{min-width:105px;padding:8px}.arrow{display:none}.flow{padding:18px}.flowhead{display:block}.flowhead span{display:block;margin-top:3px}}\n</style></head><body><header><a class=\"brand\" href=\"#inbox\" aria-label=\"UpCheck 홈\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 310 76\" role=\"img\" aria-label=\"UpCheck\"><rect x=\"2\" y=\"6\" width=\"64\" height=\"64\" rx=\"15\" fill=\"#6B4EFF\"/><path d=\"M16 38 L29 51 L53 26\" fill=\"none\" stroke=\"#fff\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"80\" y=\"56\" fill=\"#171321\" font-family=\"Arial,Helvetica,sans-serif\" font-weight=\"750\" font-size=\"48\" letter-spacing=\"-2\">UpCheck</text></svg>\n</a><div class=\"workspace\">워크스페이스<strong>극락쿼카</strong>제출서류 사전 점검</div><div class=\"navlabel\">WORKSPACE</div><nav aria-label=\"주 메뉴\"><a class=\"active\" href=\"#inbox\">접수 관리</a></nav><div class=\"sidebarfoot\">Upstage 워크플로우 연동<br>UpCheck · 극락쿼카</div></header><main><div class=\"crumb\">워크스페이스 &nbsp;/&nbsp; <b>접수 관리</b></div><div class=\"top\"><div><h1>제출서류, 한 번에 체크하세요.</h1><p>안내문 기준으로 첨부서류를 대조하고, 필요한 보완을 안내합니다.</p></div><div class=\"pill\" id=\"status\">연결 상태 확인 중</div></div><div id=\"message\" role=\"status\" aria-live=\"polite\"></div><section class=\"flow\" id=\"flow\"><div class=\"flowhead\">AI 워크플로우<span id=\"workflowVersion\">문서 읽기 · 서류 분류 · 누락·중복 점검</span></div><div class=\"nodes\"><div class=\"node\"><i>P</i><div><b>Parse</b><small>문서 읽기</small></div></div><span class=\"arrow\">→</span><div class=\"node\"><i>C</i><div><b>Classify</b><small>역할별 분류</small></div></div><span class=\"arrow\">→</span><div class=\"node\"><i>E</i><div><b>Extract × 3</b><small>기준 · 서류 · 불명확</small></div></div><span class=\"arrow\">→</span><div class=\"node\"><i>M</i><div><b>Merge</b><small>정보 결합</small></div></div><span class=\"arrow\">→</span><div class=\"node\"><i>I</i><div><b>Instruct</b><small>대조 · 결과 출력</small></div></div></div></section><div class=\"grid\"><section class=\"panel\" id=\"settings\"><h2>연결 설정</h2><label for=\"email\">관리자 수신 이메일</label><input id=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"현재 로그인한 Google 계정 이메일\"><p class=\"hint\" id=\"accountHint\">관리자 본인 계정의 받은편지함을 연결합니다. 다른 계정은 그 계정으로 로그인해 연결하세요. Google의 최초 권한 연결과 기관의 앱 허용 정책에 따라 접속이 제한될 수 있습니다.</p><label for=\"notice\">모집·제출 안내문</label><textarea id=\"notice\" placeholder=\"필수 서류, 팀원별 작성 조건, 제출 형식이 포함된 안내문을 붙여 넣으세요.\"></textarea><button id=\"example\" type=\"button\">MIDAS 안내문 예시 불러오기</button><details><summary>Studio 연결 설정</summary><label for=\"key\">Upstage API 키</label><input id=\"key\" type=\"password\" autocomplete=\"off\" placeholder=\"새로 등록할 때만 입력\"><p class=\"small\">키는 서버 설정에 저장하며 화면에 다시 표시하지 않습니다. 실행 권한과 사용량이 필요합니다.</p></details><details class=\"notice\" id=\"privacy\"><summary>개인정보 처리 안내</summary><p class=\"small\">메일 주소·제목·첨부 PDF와 작성자 이름·서명 표시를 누락·중복 점검에 사용합니다. 태그가 맞는 제출 메일의 PDF 원문을 Upstage AI로 전송하며, 전송 전 자동 익명화는 하지 않습니다.</p><p class=\"small\">관리자별 설정·API 키·접수 기록은 로그인 계정별로 분리합니다. 안내 메일은 이름을 일부 가리고 원문·연락처·서명 이미지를 붙이지 않습니다. 관리자용 상세 JSON에는 대조에 필요한 이름이 포함될 수 있습니다.</p><p class=\"small\">Gmail 원본, Upstage 업로드 파일·실행 결과와 앱 기록은 각각 보관됩니다. 이 앱은 자동 영구삭제나 학습 미사용을 보장하지 않습니다. 실제 개인정보를 처리하려면 기관이 수집·이용과 외부 AI 처리·국외이전 등 적용 근거, 사전 고지, 보관기간과 삭제 절차를 먼저 정해야 합니다. 서류에 포함된 일반 동의서를 AI 처리 동의로 간주하지 않습니다. 시연에는 가상 정보만 사용하세요.</p><a href=\"https://www.upstage.ai/privacy-policy\" target=\"_blank\" rel=\"noopener\">Upstage 개인정보 처리방침</a></details><label class=\"toggle\"><input id=\"privacyConfirmed\" type=\"checkbox\"><span>개인정보 처리 안내와 원문 AI 전송 범위를 확인했습니다.<br><span class=\"small\">기관의 적법한 처리 근거 확인을 대신하는 동의서는 아닙니다.</span></span></label><label class=\"toggle\"><input id=\"autoSend\" type=\"checkbox\" checked><span>확정된 누락·중복은 제출자에게 자동 안내<br><span class=\"small\">체크를 해제하면 발송 전 미리보기로 보관합니다.</span></span></label><p class=\"small\">처리 안내 확인과 자동 안내 설정은 점검 중에도 저장할 수 있습니다. 안내문·API 키 변경은 중지 후 저장하세요.</p><div class=\"actions\"><button class=\"primary\" id=\"save\">설정 저장</button><button id=\"start\">자동 점검 시작</button><button id=\"stop\">중지</button></div><div class=\"notice\">제목이 <b>[서류체크 실험]</b>으로 시작하는 새 메일만 처리합니다. 5분 주기로 확인하며, 불명확한 서류는 자동 회신하지 않습니다.</div></section><section class=\"panel\" id=\"inbox\"><div class=\"top\"><h2>접수 및 점검 결과</h2><div class=\"actions\" style=\"margin:0\"><button id=\"scan\">지금 확인</button><button id=\"refresh\">새로고침</button></div></div><div class=\"counts\"><div><strong id=\"total\">0</strong><span>접수 메일</span></div><div><strong id=\"sent\">0</strong><span>보완 안내 발송</span></div><div><strong id=\"review\">0</strong><span>담당자 확인</span></div></div><p id=\"connectionMeta\" class=\"small\"></p><div id=\"records\"><div class=\"empty\">아직 접수 기록이 없습니다.<br>설정을 저장하고 자동 점검을 시작해 주세요.</div></div><p class=\"small\">보완 파일은 원래 안내 메일에 답장으로 보내도록 안내합니다. 동일 파일명은 최신 파일로 대체하고, 같은 메일에는 안내를 한 번만 발송합니다. 일시적 오류는 다음 점검에서 최대 3회 자동 재시도하며, 권한 오류나 반복 실패는 담당자 확인으로 전환합니다.</p></section></div><p class=\"small\">점검 범위: PDF 내용과 작성자별 누락·중복. HWP 원본의 첨부 여부는 별도 기록하며 내용 일치, 서명 진위, 선발 자격은 담당자가 확인합니다.</p></main><script>\nconst $=x=>document.getElementById(x);let busy=false;\nconst states={RETRY_WAIT:'자동 재시도 대기',RETRY:'재점검 대기',UPLOADING:'첨부 업로드 중',PROCESSING:'AI 점검 중',REVIEW:'담당자 확인',COMPLETE:'PDF 내용 완비',READY:'안내 미리보기',SENDING:'발송 확인 중',SENT:'보완 안내 발송',SUPERSEDED:'보완 메일로 대체됨'};\nfunction rpc(name,...args){return new Promise((resolve,reject)=>{if(!window.google?.script?.run){reject(new Error('아직 Gmail에 연결되지 않은 화면입니다. Apps Script에 배포한 후 담당자 계정으로 열어 주세요.'));return;}google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[name](...args);});}\nfunction message(text,error=false){$('message').textContent=text;$('message').className=error?'error':'ok';}\nfunction render(d,preserveInputs=false){$('workflowVersion').textContent='문서 읽기 · 서류 분류 · 누락·중복 점검';$('connectionMeta').textContent=(d.keyConfigured?'등록된 키 끝 4자리: '+d.keySuffix:'API 키 미등록')+' · 최근 메일 점검: '+(d.lastScan?new Date(d.lastScan).toLocaleString('ko-KR'):'아직 없음');$('status').textContent=d.config.enabled?'자동 점검 실행 중':'자동 점검 중지';if(!preserveInputs){$('email').value=d.config.managerEmail||d.currentUser||'';$('accountHint').textContent='로그인 계정: '+d.currentUser+' · 이 계정의 받은편지함만 점검합니다.';$('privacyConfirmed').checked=d.config.privacyConfirmed===true;$('notice').value=d.config.notice||$('notice').value;$('autoSend').checked=d.config.autoSend!==false;}$('total').textContent=d.records.length;$('sent').textContent=d.records.filter(x=>x.status==='SENT').length;$('review').textContent=d.records.filter(x=>x.status==='REVIEW').length;$('records').replaceChildren();if(!d.records.length){const e=document.createElement('div');e.className='empty';e.textContent='아직 접수 기록이 없습니다. 실험 메일이 도착하면 이곳에 나타납니다.';$('records').append(e);}for(const r of d.records){const row=document.createElement('article');row.className='item';const top=document.createElement('div');top.className='itemtop';const title=document.createElement('span');title.className='subject';title.textContent=r.subject;const status=document.createElement('span');status.className='status'+(r.status==='REVIEW'?' warning':'');status.textContent=states[r.status]||r.status;top.append(title,status);const from=document.createElement('div');from.className='small';from.textContent=r.sender+' · '+new Date(r.createdAt).toLocaleString('ko-KR');const info=document.createElement('div');info.className='details';info.textContent=r.error||(r.result?.reason)||'첨부서류를 처리하고 있습니다.';row.append(top,from,info);if(r.replyPreview){const detail=document.createElement('details');const sum=document.createElement('summary');sum.textContent='보완 안내 내용';const pre=document.createElement('pre');pre.textContent=r.replyPreview;detail.append(sum,pre);row.append(detail);}if(r.status==='REVIEW'&&!r.jobId&&!r.sentAt&&/^Upstage 연결 오류 \\((401|403),?/.test(r.error||'')){const retry=document.createElement('button');retry.textContent='연결 수정 후 최신 실패 건 재점검';retry.onclick=()=>action('retryLatestConnectionFailure');row.append(retry);}if(r.status==='REVIEW'&&r.result&&!r.sentAt&&!r.sendingStartedAt){const retry=document.createElement('button');retry.textContent='이 접수 다시 점검';retry.onclick=()=>action('retryReview',r.messageId);row.append(retry);}if(r.result){const d=document.createElement('details');d.className='result-json';const h=document.createElement('summary');h.textContent='관리자용 판정 근거 · JSON (이름 포함)';const v=document.createElement('pre');v.textContent=JSON.stringify(r.result,null,2);d.append(h,v);row.append(d);}$('records').append(row);} }\nasync function action(name,...args){if(busy)return;busy=true;document.querySelectorAll('button').forEach(b=>b.disabled=true);message('처리 중입니다…');try{render(await rpc(name,...args));message(name==='saveConfiguration'?'설정을 저장했습니다.':'처리 상태를 갱신했습니다.');}catch(e){message(e.message,true);}finally{busy=false;$('key').value='';document.querySelectorAll('button').forEach(b=>b.disabled=false);}}\n$('save').onclick=()=>action('saveConfiguration',{managerEmail:$('email').value,notice:$('notice').value,apiKey:$('key').value,autoSend:$('autoSend').checked,privacyConfirmed:$('privacyConfirmed').checked});$('start').onclick=()=>action('setRunning',true);$('stop').onclick=()=>action('setRunning',false);$('scan').onclick=()=>action('runNow');$('refresh').onclick=()=>action('getDashboard');\n$('example').onclick=()=>{$('notice').value='2026학년도 2학기 MIDAS GROUP(전공형, 융합형) 모집\\n모집 기간: 2026. 8. 18. ~ 8. 28. 13시까지\\n그룹당 인원 3명 이상.\\n개인정보 동의서는 팀원 모두 작성.\\n신청서, 활동계획서, 활동서약서는 팀별 1부 작성.\\n한글 원본파일, PDF파일(서명본) 각 1부씩 제출.\\n본 실험에서는 제출서류의 누락·중복만 사전 점검하며 선발 자격과 서명 진위는 판단하지 않습니다.';};\ndocument.querySelectorAll('a[href^=\"#\"]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();document.getElementById(link.getAttribute('href').slice(1))?.scrollIntoView({behavior:'smooth'});}));\naction('getDashboard');\nsetInterval(async()=>{if(busy||document.hidden)return;try{render(await rpc('getDashboard'),true);}catch(e){}},15000);\n</script></body></html>\n";
